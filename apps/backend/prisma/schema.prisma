generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model District {
  id              String           @id @default(uuid())
  name            String
  code            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  trainingCenters TrainingCenter[]
  users           User[]

  @@map("districts")
}

model TrainingCenter {
  id         String      @id @default(uuid())
  name       String
  code       String      @unique
  districtId String
  district   District    @relation(fields: [districtId], references: [id], onDelete: Restrict)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  candidates Candidate[]
  batches    Batch[]

  @@index([districtId])
  @@map("training_centers")
}

model User {
  id                  String              @id @default(uuid())
  name                String
  email               String              @unique
  password            String
  districtId          String?
  trainingCenterId    String?
  district            District?           @relation(fields: [districtId], references: [id], onDelete: Restrict)
  trainingCenter      TrainingCenter?     @relation(fields: [trainingCenterId], references: [id], onDelete: Restrict)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  userRoles           UserRole[]
  tasks               Task[]
  createdRuleVersions     CourseRuleVersion[]
  createdBatches          Batch[]
  reviewedBatchCandidates BatchCandidate[]    @relation("ReviewedBatchCandidates")
  issuedCertificates      Certificate[]       @relation("IssuedCertificates")
  revokedCertificates     Certificate[]       @relation("RevokedCertificates")
  createdPartnerApiKeys   PartnerApiKey[]     @relation("CreatedPartnerApiKeys")
  revokedPartnerApiKeys   PartnerApiKey[]     @relation("RevokedPartnerApiKeys")
  auditLogs               AuditLog[]

  @@index([districtId])
  @@index([trainingCenterId])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  description     String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  completed   Boolean  @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
  @@map("tasks")
}

model Course {
  id                   String              @id @default(uuid())
  code                 String              @unique
  name                 String
  currentRuleVersionId String?             @unique
  currentRuleVersion   CourseRuleVersion?  @relation("CurrentCourseRule", fields: [currentRuleVersionId], references: [id], onDelete: Restrict)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  ruleVersions         CourseRuleVersion[] @relation("CourseRuleVersions")
  batches              Batch[]

  @@map("courses")
}

model CourseRuleVersion {
  id                   String   @id @default(uuid())
  courseId             String
  version              Int
  minAttendancePercent Float
  minMarksPercent      Float
  practicalRequired    Boolean
  minPracticalPercent  Float?
  createdById          String
  createdAt            DateTime @default(now())

  course           Course  @relation("CourseRuleVersions", fields: [courseId], references: [id], onDelete: Restrict)
  currentForCourse Course? @relation("CurrentCourseRule")
  createdBy        User    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  batches          Batch[]

  @@unique([courseId, version])
  @@index([courseId])
  @@index([createdById])
  @@map("course_rule_versions")
}

model Candidate {
  id               String           @id @default(uuid())
  trainingCenterId String
  candidateRef     String
  fullName         String
  phone            String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  trainingCenter   TrainingCenter   @relation(fields: [trainingCenterId], references: [id], onDelete: Restrict)
  batchCandidates  BatchCandidate[]

  @@unique([trainingCenterId, candidateRef])
  @@index([trainingCenterId])
  @@map("candidates")
}

model Batch {
  id               String              @id @default(uuid())
  trainingCenterId String
  courseId         String
  ruleVersionId    String
  status           String              @default("DRAFT")
  createdById      String
  createdAt        DateTime            @default(now())
  submittedAt      DateTime?
  trainingCenter   TrainingCenter      @relation(fields: [trainingCenterId], references: [id], onDelete: Restrict)
  course           Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  ruleVersion      CourseRuleVersion   @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  createdBy        User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  candidates       BatchCandidate[]

  @@index([trainingCenterId])
  @@index([courseId])
  @@index([ruleVersionId])
  @@index([createdById])
  @@map("batches")
}

model BatchCandidate {
  id                   String       @id @default(uuid())
  batchId              String
  candidateId          String
  candidateRefSnapshot String
  fullNameSnapshot     String
  phoneSnapshot        String
  attendancePercent    Float
  marksPercent         Float
  practicalPercent     Float?
  qualified            Boolean
  qualificationReasons Json
  reviewStatus         String       @default("PENDING")
  reviewedById         String?
  reviewedAt           DateTime?
  reviewReason         String?
  batch                Batch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  candidate            Candidate    @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  reviewedBy           User?        @relation("ReviewedBatchCandidates", fields: [reviewedById], references: [id], onDelete: Restrict)
  certificate          Certificate?

  @@unique([batchId, candidateId])
  @@index([candidateId])
  @@index([reviewedById])
  @@index([batchId, reviewStatus])
  @@map("batch_candidates")
}

model Certificate {
  id               String         @id @default(uuid())
  batchCandidateId String         @unique
  verificationCode String         @unique
  status           String         @default("ISSUED")
  issuedById       String
  issuedAt         DateTime       @default(now())
  pdfBytes         Bytes
  revokedById      String?
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  batchCandidate   BatchCandidate @relation(fields: [batchCandidateId], references: [id], onDelete: Restrict)
  issuedBy         User           @relation("IssuedCertificates", fields: [issuedById], references: [id], onDelete: Restrict)
  revokedBy        User?          @relation("RevokedCertificates", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([issuedById])
  @@index([revokedById])
  @@index([status])
  @@map("certificates")
}

model PartnerApiKey {
  id          String    @id @default(uuid())
  name        String
  prefix      String    @unique
  secretHash  String    @unique
  scopes      String[]
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedById String?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  updatedAt   DateTime  @updatedAt
  createdBy   User      @relation("CreatedPartnerApiKeys", fields: [createdById], references: [id], onDelete: Restrict)
  revokedBy   User?     @relation("RevokedPartnerApiKeys", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("partner_api_keys")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  details    Json
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id             String    @id @default(uuid())
  eventType      String
  aggregateId    String
  payload        Json
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now())
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  leaseExpiresAt DateTime?
  attempts       Int       @default(0)
  lastError      String?
  publishedAt    DateTime?
  processedAt    DateTime?
  deadLetteredAt DateTime?
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([publishedAt, createdAt])
  @@index([status, availableAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([aggregateId])
  @@map("outbox_events")
}
