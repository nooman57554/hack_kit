{
    "name": "@hackkit/backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "prisma:generate": "dotenv run -f ../../.env -- prisma generate",
        "prisma:migrate": "dotenv run -f ../../.env -- prisma migrate dev",
        "prisma:seed": "dotenv run -f ../../.env -- prisma db seed"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.6",
        "prisma": "^6.19.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}