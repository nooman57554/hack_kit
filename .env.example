PORT=5000
HOST=127.0.0.1
NODE_ENV=development

POSTGRES_USER=hackkit
POSTGRES_PASSWORD=hackkit_dev
POSTGRES_DB=hackkit

DATABASE_URL=postgresql://hackkit:hackkit_dev@127.0.0.1:5433/hackkit?schema=public

JWT_SECRET=replace_with_a_cryptographically_random_secret_32_plus_chars
PARTNER_KEY_HASH_SECRET=replace_with_a_cryptographically_random_secret_32_plus_chars

# Verification rate limits (requests per 15-minute window)
PUBLIC_VERIFY_RATE_LIMIT_MAX=30
PARTNER_VERIFY_RATE_LIMIT_MAX=120
PARTNER_BULK_VERIFY_RATE_LIMIT_MAX=30

# Transactional outbox worker
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_DURATION_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=60000

# Development seed password for demo accounts
DEMO_USER_PASSWORD=SkillPassDemo123!
